# ---------------------------------------------------------------------------
# Frontend config (Vite). Copy to `.env.local` and fill in.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# URL of the deployed BOTRON RAG backend's /chat endpoint.
# Leave EMPTY to run fully local: BOTRON then answers from a short built-in
# summary and never makes a network request. See rag/README.md.
#   FastAPI Cloud: https://your-app.fastapi.app/chat
VITE_RAG_API_URL=
