{
  "name": "botron-3d-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static portfolio (BOTRON) — built with Vite, output is pure static files",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fonts": "node scripts/fetch-fonts.mjs",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.{html,json}\" \"backend/**/*.py\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\" \"*.{html,json}\" \"backend/**/*.py\""
  },
  "dependencies": {
    "gsap": "3.12.5",
    "lenis": "1.1.14",
    "three": "0.169.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  }
}
