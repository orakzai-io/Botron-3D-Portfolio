# Groq Cloud API Key (Obtain free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models in priority rotation order (Best of the best -> Mid-tier -> Emergency fallback):
# 1. openai/gpt-oss-120b  (Highest reasoning capacity, 120B)
# 2. qwen/qwen3.8-27b     (Fast, capable 27B -- Groq marks this Preview)
# 3. openai/gpt-oss-20b   (Lightweight emergency fallback, 20B)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Port for local dev server
PORT=8000

# Minimum cosine similarity for a chunk to be considered relevant.
# Below this, /chat answers "I don't have that" WITHOUT calling the LLM, so an
# off-topic question can never be answered from unrelated biography text.
#
# There are two backends on two very different score scales, so there are two
# knobs. Read the header comment in retriever.py before changing them. Leaving
# both unset uses the calibrated defaults (dense 0.35 / lexical 0.06).
#
# Do NOT set MIN_SIMILARITY unless you run a single backend: it overrides BOTH
# floors, and the dense value (0.35) rejects the median on-topic lexical query --
# that is the cold-start "I don't have that" bug described in retriever.py.
#
# NOTE: main.py calls load_dotenv() BEFORE `from retriever import retriever`, and
# retriever.py reads these at import time, so that ordering is load-bearing.
# DENSE_MIN_SIMILARITY=0.35
# LEXICAL_MIN_SIMILARITY=0.06

# Comma-separated browser origins allowed to call /chat.
ALLOWED_ORIGINS=https://orakzai.io,https://www.orakzai.io,https://orakzai-io.github.io
