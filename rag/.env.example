# Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq model rotation (primary -> failover)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Server port
PORT=8000

# Optional similarity threshold overrides (defaults: dense=0.35, lexical=0.06)
# DENSE_MIN_SIMILARITY=0.35
# LEXICAL_MIN_SIMILARITY=0.06

# Allowed CORS origins
ALLOWED_ORIGINS=https://orakzai.io,https://www.orakzai.io,https://orakzai-io.github.io,http://localhost:5173,http://localhost:3000
